# Used by pdf_research_agent_local.py, youtube_agent.py, app.py, and
# txl_cloud.py/chat_app.py (all the free-tier agents) - unless
# CHAT_GROQ_API_KEY below is also set, in which case chat_app.py uses that
# one instead. Get a free key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Optional - a SEPARATE Groq API key (from a different Groq account) just
# for TXL Cloud (chat_app.py). Without this, TXL Cloud shares the same
# daily free-tier token quota as TXL Analyser (app.py) via GROQ_API_KEY
# above - heavy use of one eats into the other's headroom. Set this (from
# a second, separate Groq account - multiple keys on the SAME account
# still share one quota) to give TXL Cloud its own independent quota.
# Leave blank to keep sharing the one key above.
CHAT_GROQ_API_KEY=

# Optional - only needed if YouTube blocks transcript requests from your IP
# (usually only happens on cloud hosts like Render, not on your home PC).
# Format: http://user:pass@host:port
# IMPORTANT (tested): free/datacenter proxies do NOT work here - YouTube
# blocks datacenter IP ranges as a class, including free proxy tiers like
# Webshare's. Only a paid *residential* proxy actually bypasses this. Leave
# blank to skip - PDF summaries work fine either way, only YouTube summaries
# on a public cloud deployment are affected.
PROXY_URL=

# Optional - only used by app.py when deployed publicly (e.g. on Render), to
# require a password before anyone can use the site. Leave blank for local use.
SITE_PASSWORD=

# Optional - automatic fallback for TXL Cloud (chat_app.py, Groq backend
# only): if Groq's daily free quota runs out mid-conversation, it seamlessly
# switches to Gemini instead of erroring out, using this key. Get a free key
# (no credit card) at https://aistudio.google.com/apikey. Leave blank to
# skip - Groq requests just fail normally once its quota is exhausted.
GEMINI_API_KEY=

# Optional - comma-separated emails allowed to see /admin (account/usage
# counts) in TXL Cloud (chat_app.py). Leave blank and nobody can.
ADMIN_EMAILS=

# Only needed for pdf_research_agent.py (the paid Claude edition)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional - session cookie signing key for Txl GPT (txlgpt_app.py). Falls
# back to SECRET_KEY, then an insecure dev default, if unset. Set a real
# random value before deploying Txl GPT publicly.
TXLGPT_SECRET_KEY=

# Optional - needed for the "forgot password" email to actually send (see
# mailer.py). Without all three of SMTP_HOST/SMTP_USER/SMTP_PASSWORD set,
# the reset-password page tells the user plainly that email isn't
# configured instead of pretending to send. Works with any SMTP provider -
# using SendGrid here as an example (smtp.sendgrid.net, username is
# literally "apikey", password is a SendGrid API key restricted to "Mail
# Send"). SMTP_FROM must be an address verified with your provider (e.g.
# SendGrid's Single Sender Verification).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=

# Optional - SMTP account used to send "reset your password" emails, for
# both TXL Cloud (chat_app.py) and Txl GPT (txlgpt_app.py). A free Gmail
# account works - use an "app password", not your normal login password
# (create one at https://myaccount.google.com/apppasswords). Leave blank
# and the forgot-password page just says it isn't set up yet.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional - override the Gemini model Txl GPT's 🖼 image-generation button
# uses (txl_gemini.py). Only needed if the default (gemini-2.5-flash-image)
# gets renamed/retired - check https://ai.google.dev/gemini-api/docs/models
# for the current image-capable model id.
GEMINI_IMAGE_MODEL=
