# Used by pdf_research_agent_local.py, youtube_agent.py, app.py,
# txl_cloud.py/chat_app.py, and txlgpt_groq.py/txlgpt_app.py (all the
# free-tier agents) - unless that app's own separate key below is also
# set (CHAT_GROQ_API_KEY / TXLGPT_GROQ_API_KEY), in which case it uses
# that one instead. Get a free key (no credit card):
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Optional - a SEPARATE Groq API key (from a different Groq account) just
# for TXL Cloud (chat_app.py). Without this, TXL Cloud shares the same
# daily free-tier token quota as TXL Analyser (app.py) via GROQ_API_KEY
# above - heavy use of one eats into the other's headroom. Set this (from
# a second, separate Groq account - multiple keys on the SAME account
# still share one quota) to give TXL Cloud its own independent quota.
# Leave blank to keep sharing the one key above.
CHAT_GROQ_API_KEY=

# Optional - same idea as CHAT_GROQ_API_KEY, but for Txl GPT (txlgpt_app.py,
# via its own txlgpt_groq.py) - a THIRD separate Groq account/quota,
# independent from both TXL Analyser and TXL Cloud. Leave blank to fall
# back to the shared GROQ_API_KEY above.
TXLGPT_GROQ_API_KEY=

# Optional - only needed if YouTube blocks transcript requests from your IP
# (usually only happens on cloud hosts like Render, not on your home PC).
# Format: http://user:pass@host:port
# IMPORTANT (tested): free/datacenter proxies do NOT work here - YouTube
# blocks datacenter IP ranges as a class, including free proxy tiers like
# Webshare's. Only a paid *residential* proxy actually bypasses this. Leave
# blank to skip - PDF summaries work fine either way, only YouTube summaries
# on a public cloud deployment are affected.
PROXY_URL=

# Optional - shared by app.py, chat_app.py, and txlgpt_app.py: when deployed
# publicly (e.g. on Render), requires this password (via a browser's basic-auth
# prompt) before anyone can reach the site at all - on top of real accounts.
# Leave blank for local use.
SITE_PASSWORD=

# Optional - shared by chat_app.py and txlgpt_app.py: requires this code to
# sign up (on top of SITE_PASSWORD, if also set) - stops anyone who has
# SITE_PASSWORD from creating their own account and using Code/Work mode's
# run_command on a public deployment. Leave blank and signup stays open to
# anyone who reaches it.
SIGNUP_INVITE_CODE=

# Optional, but used by both TXL Cloud and Txl GPT - same key, two
# independent purposes since each app has its own Gemini connector file:
#   - TXL Cloud (chat_app.py, Groq backend only): automatic fallback - if
#     Groq's daily free quota runs out mid-conversation, it seamlessly
#     switches to Gemini instead of erroring out.
#   - Txl GPT (txlgpt_app.py): pasted-image understanding (vision) and the
#     🖼 image-generation button, via txlgpt_gemini.py.
# Get a free key (no credit card) at https://aistudio.google.com/apikey.
# Leave blank to skip - TXL Cloud's Groq requests just fail normally once
# exhausted, and Txl GPT's vision/image features show a clear "not
# configured" message instead of erroring.
GEMINI_API_KEY=

# Optional - comma-separated emails allowed to see /admin (account/usage
# counts) in TXL Cloud (chat_app.py). Leave blank and nobody can.
ADMIN_EMAILS=

# Only needed for pdf_research_agent.py (the paid Claude edition)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional - session cookie signing key for Txl GPT (txlgpt_app.py). Falls
# back to SECRET_KEY, then an insecure dev default, if unset. Set a real
# random value before deploying Txl GPT publicly.
TXLGPT_SECRET_KEY=

# Optional - needed for the "forgot password" email to actually send (see
# mailer.py), for both TXL Cloud (chat_app.py) and Txl GPT (txlgpt_app.py).
# Without all three of SMTP_HOST/SMTP_USER/SMTP_PASSWORD set, the
# reset-password page tells the user plainly that email isn't configured
# instead of pretending to send. Works with any SMTP provider - a free
# Gmail account works too (use an "app password", not your normal login
# password - create one at https://myaccount.google.com/apppasswords).
# The example below uses SendGrid instead (smtp.sendgrid.net, username is
# literally "apikey", password is a SendGrid API key restricted to "Mail
# Send") - recommended for a Render deployment specifically, since PaaS
# hosts commonly block outbound SMTP ports (see mailer.py's docstring).
# SMTP_FROM must be an address verified with your provider (e.g. SendGrid's
# Single Sender Verification).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=

# Optional - override the Gemini model Txl GPT's 🖼 image-generation button
# uses (txlgpt_gemini.py). Only needed if the default (gemini-2.5-flash-image)
# gets renamed/retired - check https://ai.google.dev/gemini-api/docs/models
# for the current image-capable model id.
GEMINI_IMAGE_MODEL=

# Optional - Txl GPT's Work mode only (txlgpt_code_agent.py). Off by
# default: Work mode's write_file/run_command tools stay confined to a
# sandboxed per-user folder under workspace_txlgpt/. Set
# TXLGPT_ALLOW_CUSTOM_WORKSPACE=1 to let it point at a real project folder
# instead (TXLGPT_CODE_WORKSPACE=path/to/that/folder) - local, single-user
# installs only. NEVER enable this on a public deployment: it lets Work
# mode's approval-gated tools reach anywhere on disk the process can.
TXLGPT_ALLOW_CUSTOM_WORKSPACE=
TXLGPT_CODE_WORKSPACE=
