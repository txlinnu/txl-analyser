{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "research-agent-web",
      "runtimeExecutable": "python",
      "runtimeArgs": ["app.py"],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "txl-cloud-chat",
      "runtimeExecutable": "python",
      "runtimeArgs": ["chat_app.py"],
      "port": 5001,
      "autoPort": true
    },
    {
      "name": "txl-cloud-chat-local",
      "runtimeExecutable": "python",
      "runtimeArgs": ["chat_app.py"],
      "env": { "CHAT_BACKEND": "ollama" },
      "port": 5002,
      "autoPort": true
    },
    {
      "name": "txl-gpt",
      "runtimeExecutable": "python",
      "runtimeArgs": ["txlgpt_app.py"],
      "port": 5003,
      "autoPort": true
    },
    {
      "name": "control-panel",
      "runtimeExecutable": "python",
      "runtimeArgs": ["control_panel.py"],
      "port": 5099,
      "autoPort": true
    },
    {
      "name": "render-control",
      "runtimeExecutable": "python",
      "runtimeArgs": ["render_control.py"],
      "port": 5098,
      "autoPort": true
    }
  ]
}
